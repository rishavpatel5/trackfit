# =============================================================================
# GVTrainer — copy backend block to `backend/.env`, frontend block to `frontend/.env.local`
# =============================================================================

# --- Backend -----------------------------------------------------------------

NODE_ENV=development
PORT=4000

# PostgreSQL — local Docker / Postgres:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gvtrainer?schema=public"
# Required for `prisma migrate` / `db push` (local: same as DATABASE_URL)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/gvtrainer?schema=public"

# Supabase example:
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

JWT_SECRET="change-me-to-a-long-random-string-at-least-16-chars"
JWT_EXPIRES_IN="7d"
FRONTEND_URL="http://localhost:3000"

BCRYPT_ROUNDS=12
ATTENDANCE_PIN_EXPIRY_MINUTES=20
GYM_TIMEZONE=Asia/Kolkata
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Cloudinary — image uploads only (reports stream live PDFs; no Cloudinary for PDFs)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional: Resend (https://resend.com) for password-reset email in production.
RESEND_API_KEY=""
EMAIL_FROM=""

RETURN_RESET_TOKEN=false

# Bootstrap admin only (`npx prisma db seed` or `npm run db:seed:admin`)
SEED_ADMIN_EMAIL=you@yourcompany.com
SEED_ADMIN_PASSWORD=change-me-strong-8-chars-min
# Optional: SEED_ADMIN_FIRST_NAME=  SEED_ADMIN_LAST_NAME=  SEED_ADMIN_PHONE=
# To reset admin password after first seed: SEED_FORCE_ADMIN_PASSWORD=true

# --- Frontend ----------------------------------------------------------------

NEXT_PUBLIC_API_URL="http://localhost:4000"
