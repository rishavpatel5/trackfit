# Backend (copy to backend/.env)
#
# Postgres must be running before `npx prisma db push`. Options:
#   A) Docker Desktop: from backend folder run `npm run db:up` (or repo root: `docker compose up -d postgres`)
#   B) Local install: ensure service listens on localhost:5432 and DB/user/password match DATABASE_URL below
#
# App runtime URL (local example)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gvtrainer?schema=public"
# Required for `prisma migrate` / `db push` — same DB, direct connection (local: same as DATABASE_URL)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/gvtrainer?schema=public"

# Supabase example (do NOT use port 6543 pooler for migrations — it will hang):
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"
JWT_SECRET="change-me-to-a-long-random-string-at-least-16-chars"
JWT_EXPIRES_IN="7d"
FRONTEND_URL="http://localhost:3000"
PORT=4000
BCRYPT_ROUNDS=12
ATTENDANCE_PIN_EXPIRY_MINUTES=20
GYM_TIMEZONE=Asia/Kolkata
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Cloudinary — required for secure image uploads (reports stream live PDFs; no Cloudinary needed)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Dev-only: include reset token in forgot-password JSON response
RETURN_RESET_TOKEN=false

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Frontend (copy to frontend/.env.local)
NEXT_PUBLIC_API_URL="http://localhost:4000"
