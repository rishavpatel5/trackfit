# =============================================================================
# GVTrainer — copy backend block to `backend/.env`, frontend block to `frontend/.env.local`
# =============================================================================

# --- Backend -----------------------------------------------------------------

NODE_ENV=development
PORT=4000

# PostgreSQL — Supabase (free tier): use pooler URL for DATABASE_URL to limit connections.
# Example pooler:
# DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Example direct (Prisma Migrate / introspection):
# DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gvtrainer?schema=public"
DIRECT_URL=

JWT_SECRET="change-me-to-a-long-random-string-at-least-16-chars"
JWT_EXPIRES_IN="7d"
FRONTEND_URL="http://localhost:3000"

BCRYPT_ROUNDS=12
ATTENDANCE_PIN_EXPIRY_MINUTES=20
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Cloudinary — image uploads only; URLs stored in Postgres (no Supabase Storage).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional: Resend (https://resend.com) for password-reset email in production.
RESEND_API_KEY=""
EMAIL_FROM=""

RETURN_RESET_TOKEN=false

# --- Bootstrap admin ONLY (`npx prisma db seed`) ------------------------------
# Required for seed. Creates one ADMIN user — no demo trainer/client.
SEED_ADMIN_EMAIL=you@yourcompany.com
SEED_ADMIN_PASSWORD=change-me-strong-8-chars-min
# Optional: SEED_ADMIN_FIRST_NAME=  SEED_ADMIN_LAST_NAME=  SEED_ADMIN_PHONE=
# To reset admin password after first seed: SEED_FORCE_ADMIN_PASSWORD=true (run seed once, then remove)

# --- Frontend ----------------------------------------------------------------

NEXT_PUBLIC_API_URL="http://localhost:4000"
